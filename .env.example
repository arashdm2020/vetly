# Copy to .env.local for LOCAL development. Do not commit .env.local.
TURSO_DATABASE_URL=file:vetly-development.db
TURSO_AUTH_TOKEN=
# On Vercel, use the remote URL and token supplied by the Turso integration.
# Use distinct preview and production databases. Do not add NEXT_PUBLIC_ prefixes.
# Required for a deployed clinic (not needed for local npm run dev):
CLINIC_PASSWORD=
SESSION_SECRET=
# Exactly 64 hexadecimal characters. Keep stable to decrypt saved API keys.
SETTINGS_ENCRYPTION_KEY=
# At least 32 characters; used only by the protected reminder endpoint.
CRON_SECRET=
