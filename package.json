    "test": "node --conditions=react-server --import ./scripts/register-tests.mjs --test scripts/integration.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
